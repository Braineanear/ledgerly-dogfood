# Copy to web/.env.local for local development. Never commit .env.local.
#
# WARNING: every VITE_-prefixed variable is exposed to the browser. Never put
# API_TOKEN or any other secret in a VITE_ variable.
#
# Base URL the browser calls. The default /api is served by the Vite dev proxy.
VITE_API_BASE_URL=/api
# Read only by the dev proxy on the server side. These are not VITE_ variables.
API_PROXY_TARGET=http://localhost:8000
API_TOKEN=REPLACE_ME
