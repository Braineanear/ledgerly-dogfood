# Copy to .env and replace every REPLACE_ME. Never commit .env.
#
# compose.yaml uses ${VAR:-}, so `docker compose config` renders with
# variables unset. Real values are required before `docker compose up`.
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
# POSTGRES_PASSWORD_URLENCODED must be the SAME password as POSTGRES_PASSWORD,
# percent-encoded, because it is placed inside DATABASE_URL. Examples:
#   @ -> %40    : -> %3A    / -> %2F    # -> %23
POSTGRES_PASSWORD_URLENCODED=REPLACE_ME
POSTGRES_DB=REPLACE_ME
API_TOKEN=REPLACE_ME
VITE_API_URL=http://localhost:8000
